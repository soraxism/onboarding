  <diagram id="pattern-4. ガイド＋カスタムレイヤー＋AI" name="4. ガイド＋カスタムレイヤー＋AI">
    <mxGraphModel dx="1600" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Onboarding 機能構成図 ｜ ガイド＋カスタムレイヤー＋AI" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="20" y="14" width="700" height="38" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="配信タグ方式（onboarding-init）　／　ガイド＝ツアー・ポップアップ・ヒント・フロート　／　2026-10-15 時点" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#52606D;" vertex="1" parent="1">
          <mxGeometry x="22" y="56" width="660" height="24" as="geometry" />
        </mxCell>
        <mxCell id="flowNote" value="&lt;b&gt;貴社サイトでの動作の流れ&lt;/b&gt;&lt;br&gt;① 配信タグが配信 CDN から初期化スクリプト・ガイド本体（JS / CSS）を読み込む&lt;br&gt;② 初期化 API へ、訪問者・ページに応じて表示するガイドを問い合わせ&lt;br&gt;③ ガイドの表示・操作ログを計測ビーコンへ送信&lt;br&gt;④ カスタムレイヤー タグが専用 JS を読み込み、独自 UI を表示&lt;br&gt;⑤ AI チャット・AI ヒントが AI 応答基盤と通信し、やり取りをログに記録" style="rounded=1;arcSize=6;html=1;fillColor=#FFF4E8;strokeColor=#DD7B22;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=10;fontColor=#7A3E04;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="740" y="10" width="460" height="104" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;矢印は主要なデータの流れを示します" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#CBD2D9;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=10.5;fontColor=#52606D;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1220" y="10" width="320" height="104" as="geometry" />
        </mxCell>
        <mxCell id="legendSw1" value="" style="rounded=0;html=1;fillColor=#FFF4E8;strokeColor=#DD7B22;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1232" y="40" width="20" height="13" as="geometry" />
        </mxCell>
        <mxCell id="legendTx1" value="貴社サイトへの配信に関わる構成" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#52606D;" vertex="1" parent="1">
          <mxGeometry x="1258" y="39" width="270" height="15" as="geometry" />
        </mxCell>
        <mxCell id="legendSw2" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;strokeWidth=1.3;" vertex="1" parent="1">
          <mxGeometry x="1232" y="58" width="20" height="13" as="geometry" />
        </mxCell>
        <mxCell id="legendTx2" value="弊社側の管理・運用" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#52606D;" vertex="1" parent="1">
          <mxGeometry x="1258" y="57" width="270" height="15" as="geometry" />
        </mxCell>
        <mxCell id="aBox" value="エンドユーザーのブラウザ（貴社 Web サイト）" style="rounded=1;arcSize=2;html=1;fillColor=#F5F7FA;strokeColor=#CBD2D9;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#3E4C59;" vertex="1" parent="1">
          <mxGeometry x="20" y="120" width="1120" height="305" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="&lt;b&gt;画面に表示されるガイド UI&lt;/b&gt;&lt;br&gt;&lt;br&gt;ツアー／ポップアップ／ヒント／フロート／AI チャット／カスタムレイヤーの独自 UI&lt;br&gt;&lt;br&gt;貴社サイトの既存の画面構造は変更せず、上に重ねて表示します" style="rounded=1;arcSize=6;html=1;fillColor=#FFF4E8;strokeColor=#DD7B22;strokeWidth=2.2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=10.5;fontColor=#7A3E04;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="165" width="1080" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;① 配信タグ&lt;/b&gt;&lt;br&gt;&lt;br&gt;貴社サイトに設置する script タグ 1 行&lt;br&gt;初期化スクリプト（onboarding-init.js）を読み込む" style="rounded=1;arcSize=6;html=1;fillColor=#FFF4E8;strokeColor=#DD7B22;strokeWidth=2.2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=10.5;fontColor=#7A3E04;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;④ カスタムレイヤー タグ&lt;/b&gt;&lt;br&gt;&lt;br&gt;貴社向けに個別開発した JS を読み込む script タグ&lt;br&gt;専用 ID ごとに配信" style="rounded=1;arcSize=6;html=1;fillColor=#FFF4E8;strokeColor=#DD7B22;strokeWidth=2.2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=10.5;fontColor=#7A3E04;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="400" y="290" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="aNote" value="貴社サイトに設置いただくのは、この 2 行 のタグのみです。&lt;br&gt;既存ページの HTML・CSS・JavaScript の改修は必要ありません。" style="rounded=1;arcSize=6;html=1;dashed=1;dashPattern=6 4;fillColor=none;strokeColor=#B6BFC9;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=12;fontSize=10.5;fontColor=#52606D;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="760" y="290" width="360" height="110" as="geometry" />
