        <mxCell id="cp1" value="&lt;b&gt;管理 API&lt;/b&gt;&lt;br&gt;&lt;br&gt;ガイド・表示条件・配信設定の管理" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=10.5;fontColor=#3E4C59;whiteSpace=wrap;" vertex="1" parent="1">
