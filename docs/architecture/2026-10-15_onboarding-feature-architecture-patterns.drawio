        <mxCell id="cCdn" value="&lt;b&gt;配信アセット CDN&lt;/b&gt;&lt;br&gt;&lt;br&gt;初期化スクリプト&lt;br&gt;（onboarding-init.js）&lt;br&gt;ガイド本体の JS / CSS・テーマ&lt;br&gt;見た目を調整するカスタム CSS / JS" style="rounded=1;arcSize=6;html=1;fillColor=#FFF4E8;strokeColor=#DD7B22;strokeWidth=2.2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=10.5;fontColor=#7A3E04;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="525" width="200" height="155" as="geometry" />
