        </mxCell>
        <mxCell id="e1" value="&lt;b&gt;ガイドデータ&lt;/b&gt;&lt;br&gt;&lt;br&gt;ツアー／ポップアップ／ヒント／フロートの定義、デザインテーマ、カスタム CSS・JS" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#7B96B8;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=10.5;fontColor=#33506E;whiteSpace=wrap;" vertex="1" parent="1">
