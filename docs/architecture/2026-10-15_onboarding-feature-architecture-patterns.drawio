        <mxCell id="b2" value="&lt;b&gt;エディタ拡張／プレビュー拡張&lt;/b&gt;&lt;br&gt;&lt;br&gt;実際の画面上でのガイド作成と、公開前の表示確認" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=10.5;fontColor=#3E4C59;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1178" y="295" width="344" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cBox" value="Onboarding 配信基盤" style="rounded=1;arcSize=2;html=1;fillColor=#F5F7FA;strokeColor=#CBD2D9;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#3E4C59;" vertex="1" parent="1">
