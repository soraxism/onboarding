        <mxCell id="cp2" value="&lt;b&gt;編集／同期 API&lt;/b&gt;&lt;br&gt;&lt;br&gt;拡張機能からのガイド編集・同期" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=10.5;fontColor=#3E4C59;whiteSpace=wrap;" vertex="1" parent="1">
