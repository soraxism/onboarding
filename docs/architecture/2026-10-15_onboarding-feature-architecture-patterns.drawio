        <mxCell id="eBox" value="データ" style="rounded=1;arcSize=2;html=1;fillColor=#EDF3F9;strokeColor=#B4C6D9;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#33506E;" vertex="1" parent="1">
