<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.17">
  <diagram id="onboarding-feature-architecture" name="機能構成図">
    <mxGraphModel dx="1600" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Onboarding 機能構成図" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="20" y="14" width="620" height="38" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="埋め込みタグ方式（/embed・/decision）＋ カスタムレイヤー のご利用構成を強調表示　／　2026-10-15 時点" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#52606D;" vertex="1" parent="1">
          <mxGeometry x="22" y="56" width="620" height="24" as="geometry" />
        </mxCell>

        <mxCell id="flowNote" value="&lt;b&gt;貴社サイトでの動作の流れ&lt;/b&gt;&lt;br&gt;① 埋め込みタグが &lt;b&gt;/embed&lt;/b&gt; から初期化スクリプトを取得&lt;br&gt;② 初期化スクリプトが &lt;b&gt;/decision&lt;/b&gt; へ表示するガイドを問い合わせ&lt;br&gt;③ ガイド本体（JS / CSS）を配信 CDN から読み込み、画面に表示&lt;br&gt;④ カスタムレイヤー JS を CDN から読み込み、独自 UI を表示&lt;br&gt;⑤ ガイドの表示・操作ログを計測ビーコンへ送信" style="rounded=1;arcSize=6;html=1;fillColor=#FFF4E8;strokeColor=#DD7B22;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=10.5;fontColor=#7A3E04;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="680" y="14" width="520" height="92" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;矢印は主要なデータの流れを示します" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#CBD2D9;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=10.5;fontColor=#52606D;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1220" y="14" width="320" height="92" as="geometry" />
        </mxCell>
        <mxCell id="legendSw1" value="" style="rounded=0;html=1;fillColor=#FFF4E8;strokeColor=#DD7B22;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1232" y="42" width="20" height="13" as="geometry" />
        </mxCell>
        <mxCell id="legendTx1" value="貴社でご利用中の構成" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#52606D;" vertex="1" parent="1">
          <mxGeometry x="1258" y="41" width="270" height="15" as="geometry" />
        </mxCell>
        <mxCell id="legendSw2" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;strokeWidth=1.3;" vertex="1" parent="1">
          <mxGeometry x="1232" y="60" width="20" height="13" as="geometry" />
        </mxCell>
        <mxCell id="legendTx2" value="その他の提供機能（ご参考）" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#52606D;" vertex="1" parent="1">
          <mxGeometry x="1258" y="59" width="270" height="15" as="geometry" />
        </mxCell>

        <mxCell id="aBox" value="エンドユーザーのブラウザ（貴社 Web サイト）" style="rounded=1;arcSize=2;html=1;fillColor=#F5F7FA;strokeColor=#CBD2D9;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#3E4C59;" vertex="1" parent="1">
          <mxGeometry x="20" y="120" width="1120" height="305" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="&lt;b&gt;画面に表示されるガイド UI&lt;/b&gt;&lt;br&gt;ランチャー／ガイドステップ／ツールチップ／ヒント／ポップアップ／カスタムレイヤーの独自 UI&lt;br&gt;&lt;br&gt;貴社サイトの既存の画面構造は変更せず、上に重ねて表示します" style="rounded=1;arcSize=6;html=1;fillColor=#FFF4E8;strokeColor=#DD7B22;strokeWidth=2.2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#7A3E04;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="165" width="1080" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;① 埋め込みタグ&lt;/b&gt;&lt;br&gt;&lt;br&gt;貴社サイトに設置する script タグ&lt;br&gt;アカウント ID・プロダクト ID を指定して &lt;b&gt;/embed&lt;/b&gt; を読み込む" style="rounded=1;arcSize=6;html=1;fillColor=#FFF4E8;strokeColor=#DD7B22;strokeWidth=2.2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#7A3E04;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;配信タグ（新方式）&lt;/b&gt;&lt;br&gt;&lt;br&gt;onboarding-init.js を読み込む方式&lt;br&gt;&lt;br&gt;※ 貴社では未使用" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#3E4C59;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="305" y="290" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;④ カスタムレイヤー タグ&lt;/b&gt;&lt;br&gt;&lt;br&gt;貴社向けに個別開発した JS を読み込む script タグ&lt;br&gt;専用 ID ごとに配信" style="rounded=1;arcSize=6;html=1;fillColor=#FFF4E8;strokeColor=#DD7B22;strokeWidth=2.2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#7A3E04;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="570" y="290" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;Chrome 拡張（ビューワー）&lt;/b&gt;&lt;br&gt;&lt;br&gt;タグを設置せず、拡張機能でガイドを表示する方式&lt;br&gt;&lt;br&gt;※ 貴社では未使用" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#3E4C59;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="835" y="290" width="285" height="110" as="geometry" />
        </mxCell>

        <mxCell id="bBox" value="運用（弊社・貴社ご担当者）" style="rounded=1;arcSize=2;html=1;fillColor=#F5F7FA;strokeColor=#CBD2D9;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#3E4C59;" vertex="1" parent="1">
